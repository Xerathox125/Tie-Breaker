  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "En un futuro no tan lejano ni tan cercano, los humanos avanzaron tanto
    tecnol\xF3gicamente que llegaron a abrir portales interdimensionales. Una organizaci\xF3n
    gubernamental militar super secreta, Serck, es la raz\xF3n de la creaci\xF3n
    de estos portales. Mediante el uso de sus chips cerebrales, implantados en sus
    cadetes m\xE1s capaces, estos pueden abrir y cerrar estos portales de manera
    segura para explorar otras realidades. Los portales se abren con fracciones muy
    peque\xF1as de esperanza y se cierran con fracciones muy peque\xF1as del alma,
    mientras no se abuse de ello, no existen efectos secundarios. Nuestro protagonista
    Kemrai es un cadete de \xE9lite que ya ten\xEDa tiempo explorando otras realidades.
    Para esto, su hermana Liora le regal\xF3 para su primera misi\xF3n una espada,
    para poder protegerse en sus peligrosos viajes. "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
